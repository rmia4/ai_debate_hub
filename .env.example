# 서비스 공개 주소 (끝에 / 없음). 로컬: http://localhost:3000
BASE_URL=http://localhost:3000
# Neon 등 PostgreSQL 연결 주소
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# 쿠키 서명 키 (쉼표로 구분, 길고 무작위한 값). 맨 앞 키로 서명하고 모든 키로 검증한다
COOKIE_KEYS=replace-with-random-string
# 서명 키 JWKS (npm run gen-keys 출력). 비우면 개발용 키를 쓴다
JWKS=
# GitHub OAuth 앱. 콜백 주소: <BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth 클라이언트(웹 애플리케이션). 승인된 리디렉션 URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 약관·개인정보 처리방침에 표시할 운영자 연락처
CONTACT_EMAIL=
